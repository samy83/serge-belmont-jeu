# Copier ce fichier en `.env` (jamais versionne) et renseigner les valeurs.
# Toutes les variables exposees au client DOIVENT commencer par VITE_.
# Aucune de ces valeurs n'est necessaire pour jouer hors ligne : la V1 tourne sans rien.

# Identifiant d'application Facebook (Instant Games / partage). Vide = fournisseur "null".
VITE_FACEBOOK_APP_ID=

# Point d'entree de synchronisation en ligne (classement, statistiques). Vide = hors ligne seulement.
VITE_SYNC_ENDPOINT=

# Monetisation : "off" (defaut, recommande en developpement) ou "on".
VITE_MONETIZATION=off

# Forcer un palier de qualite graphique : auto | low | medium | high
VITE_QUALITY=auto

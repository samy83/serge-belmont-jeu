{
  "name": "serge-belmont-jeu",
  "version": "0.1.0",
  "private": true,
  "description": "Serge Belmont - jeu mobile de puzzle/tir physique qui revele des photographies (prototype V1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "photos:placeholders": "python tools/make_placeholder_photos.py"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
